# Copy to .pitwall.env and set your Vercel team. The real file is ignored by Git.
export SPROUT_TEAM="${SPROUT_TEAM:-your-team}"
export SPROUT_BOARD="${SPROUT_BOARD:-General}"
# Optional executable paths when launching from Finder instead of a login shell:
# export SPROUT_NODE="/absolute/path/to/node"
# export SPROUT_PYTHON="/absolute/path/to/python3"
# export SPROUT_CODEX="/absolute/path/to/codex"
# CARGO_HOME and CARGO_TARGET_DIR are supported by Cargo as usual.

# Optional local provider instance file (default: worker/agents.json):
# export PITWALL_AGENTS="/absolute/path/to/agents.json"
